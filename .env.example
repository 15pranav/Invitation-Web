ADMIN_EMAILS=your-admin-email@example.com
# Media upload configuration
MEDIA_AUDIO_MAX_MB=25
MEDIA_IMAGE_MAX_MB=15
MEDIA_VIDEO_MAX_MB=100
# Optional direct-to-R2 transport. Configure server secrets and bucket CORS;
# use the SAME private bucket as the BUCKET binding. Never use NEXT_PUBLIC_.
R2_UPLOAD_ACCOUNT_ID=
R2_UPLOAD_BUCKET=
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=
